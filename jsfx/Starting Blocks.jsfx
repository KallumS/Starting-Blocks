desc:Starting Blocks - the building blocks of a song, ready to drop into REAPER
author: Kallum Shah
about:
  # Starting Blocks

  A catalogue of the smallest useful pieces of music - chords, arpeggios, runs,
  melodic steps and leaps, bass notes and single drum hits - that you pick by
  key, scale and scale degree and then drop into a REAPER project.

  The plugin makes no sound of its own. It has no audio processing at all;
  everything it produces leaves as MIDI.

  Three ways out:
    * Audition  - plays the block live out of the plugin's MIDI output, so you
                  can hear it or record it onto a track.
    * Insert    - places the block on the selected track at the edit cursor.
    * Export    - writes the block as a .mid file into the drag bin folder,
                  which you drag into the arrange from REAPER's Media Explorer.

  Insert and Export need "Starting Blocks Bridge.lua" running: JSFX cannot
  write files or talk to the REAPER API, so the bridge does both over gmem.

options:gmem=StartingBlocks

// No @sample section: audio passes through untouched. This plugin is silent.

@init

// ---------------------------------------------------------------------------
// Memory map
// ---------------------------------------------------------------------------
MAXNOTES  = 1024;
NOTES     = 0;        // 4 words per note: startQN, lenQN, pitch, velocity
SCL_IV    = 4096;     // 16 scales * 8 semitone offsets
SCL_LT    = 4224;     // 16 scales * 8 letter offsets
SCL_N     = 4352;     // notes per scale
CH_MASK   = 4400;     // chord interval bitmask, bit n = n semitones above root
CH_FAM    = 4500;     // which family a chord belongs to
TONES     = 4700;     // scratch: the chord's pitches, ascending
POOL      = 4900;     // scratch: the pitch pool a pattern draws from
SEQ       = 5040;     // scratch: that pool in playing order
ROOT_LT   = 5200;     // root letter index
ROOT_ACC  = 5230;     // root accidental
DRUM_NOTE = 5260;     // GM note number per drum piece
LETTER_PC = 5280;     // pitch class each letter names on its own
DIA_OFF   = 5300;     // diatonic stacks: 9 shapes * 8 scale-degree offsets
DIA_CNT   = 5380;     // how many degrees each diatonic shape stacks
HITS      = 5400;     // scratch: drum hit positions within one bar

// Substring index tables: idx[k*2] = offset, idx[k*2+1] = length
IDX_SCL   = 5600;
IDX_ROOT  = 5700;
IDX_CAT   = 5760;
IDX_FAM   = 5800;
IDX_CHN   = 5860;
IDX_CHS   = 6100;
IDX_DIA   = 6340;
IDX_PAT   = 6400;
IDX_RATE  = 6480;
IDX_MOD   = 6520;
IDX_MEL   = 6560;
IDX_SHP   = 6620;
IDX_DRP   = 6660;
IDX_DRS   = 6720;
IDX_BTONE = 6780;
IDX_INV   = 6820;
IDX_NUM   = 6880;     // roman numerals, upper then lower
IDX_PCS   = 7000;     // plain pitch-class names, sharp spelling
IDX_PCF   = 7040;     // plain pitch-class names, flat spelling

// ---------------------------------------------------------------------------
// gmem protocol, shared with Starting Blocks Bridge.lua
// ---------------------------------------------------------------------------
GM_MAGIC   = 0;       // 21826 ("SB"), written once so the bridge knows we exist
GM_SEQ     = 1;       // bumped by the plugin for every request
GM_CMD     = 2;       // 1 = insert at edit cursor, 2 = export .mid
GM_ACK     = 3;       // the bridge writes back the seq it handled
GM_STATUS  = 4;       // 0 = ok, 1 = failed
GM_NCOUNT  = 5;       // how many notes follow
GM_BEATS   = 6;       // total block length in quarter notes
GM_HB      = 7;       // bridge heartbeat, counts up while the bridge runs
GM_NAMELEN = 8;
GM_NAME    = 16;      // block name, one character code per word, max 96
GM_NOTES   = 128;     // 4 words per note, same shape as NOTES

gmem[GM_MAGIC] = 21826;

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

// Builds an offset/length index over a '|' separated string. Returns the count.
function idx_build(s tbl) local(i n len start c) (
  n = 0; start = 0; len = strlen(s); i = 0;
  while (i <= len) (
    c = i < len ? str_getchar(s, i) : $'|';
    c == $'|' ? ( tbl[n*2] = start; tbl[n*2+1] = i - start; n += 1; start = i + 1; );
    i += 1;
  );
  n;
);

// Copies entry k out of an indexed string into dest.
function idx_get(dest s tbl k) (
  strcpy_substr(dest, s, tbl[k*2], tbl[k*2+1]);
  dest;
);

// Interval bitmask from up to seven semitone offsets; -1 means "unused".
function cm(a b c d e f g) (
  (a >= 0 ? 2^a : 0) + (b >= 0 ? 2^b : 0) + (c >= 0 ? 2^c : 0) +
  (d >= 0 ? 2^d : 0) + (e >= 0 ? 2^e : 0) + (f >= 0 ? 2^f : 0) +
  (g >= 0 ? 2^g : 0);
);

function chord_add(mask fam) (
  CH_MASK[n_chords] = mask;
  CH_FAM[n_chords] = fam;
  n_chords += 1;
);

function sc_add(cnt a b c d e f g h) (
  SCL_N[n_scales] = cnt;
  SCL_IV[n_scales*8+0] = a; SCL_IV[n_scales*8+1] = b; SCL_IV[n_scales*8+2] = c;
  SCL_IV[n_scales*8+3] = d; SCL_IV[n_scales*8+4] = e; SCL_IV[n_scales*8+5] = f;
  SCL_IV[n_scales*8+6] = g; SCL_IV[n_scales*8+7] = h;
);

// The letter-name each degree carries, which is what makes F# major spell its
// seventh E# rather than F. Always called straight after sc_add.
function sc_let(a b c d e f g h) (
  SCL_LT[n_scales*8+0] = a; SCL_LT[n_scales*8+1] = b; SCL_LT[n_scales*8+2] = c;
  SCL_LT[n_scales*8+3] = d; SCL_LT[n_scales*8+4] = e; SCL_LT[n_scales*8+5] = f;
  SCL_LT[n_scales*8+6] = g; SCL_LT[n_scales*8+7] = h;
  n_scales += 1;
);

function root_add(letter acc) (
  ROOT_LT[n_roots] = letter; ROOT_ACC[n_roots] = acc; n_roots += 1;
);

// ---------------------------------------------------------------------------
// Musical data
// ---------------------------------------------------------------------------

LETTER_PC[0] = 0; LETTER_PC[1] = 2; LETTER_PC[2] = 4; LETTER_PC[3] = 5;
LETTER_PC[4] = 7; LETTER_PC[5] = 9; LETTER_PC[6] = 11;

DRUM_NOTE[0] = 36; DRUM_NOTE[1] = 38; DRUM_NOTE[2] = 42; DRUM_NOTE[3] = 46;
DRUM_NOTE[4] = 49; DRUM_NOTE[5] = 51; DRUM_NOTE[6] = 41; DRUM_NOTE[7] = 47;
DRUM_NOTE[8] = 50;

n_scales = 0;
sc_add(7, 0,2,4,5,7,9,11,0);   sc_let(0,1,2,3,4,5,6,0);  // Major
sc_add(7, 0,2,3,5,7,8,10,0);   sc_let(0,1,2,3,4,5,6,0);  // Minor (natural)
sc_add(7, 0,2,3,5,7,8,11,0);   sc_let(0,1,2,3,4,5,6,0);  // Harmonic Minor
sc_add(7, 0,2,4,5,7,9,11,0);   sc_let(0,1,2,3,4,5,6,0);  // Ionian
sc_add(7, 0,2,3,5,7,9,10,0);   sc_let(0,1,2,3,4,5,6,0);  // Dorian
sc_add(7, 0,1,3,5,7,8,10,0);   sc_let(0,1,2,3,4,5,6,0);  // Phrygian
sc_add(7, 0,2,4,6,7,9,11,0);   sc_let(0,1,2,3,4,5,6,0);  // Lydian
sc_add(7, 0,2,4,5,7,9,10,0);   sc_let(0,1,2,3,4,5,6,0);  // Mixolydian
sc_add(7, 0,2,3,5,7,8,10,0);   sc_let(0,1,2,3,4,5,6,0);  // Aeolian
sc_add(5, 0,2,4,7,9,0,0,0);    sc_let(0,1,2,4,5,0,0,0);  // Major Pentatonic
sc_add(5, 0,3,5,7,10,0,0,0);   sc_let(0,2,3,4,6,0,0,0);  // Minor Pentatonic
sc_add(6, 0,2,3,4,7,9,0,0);    sc_let(0,1,2,2,4,5,0,0);  // Major Blues
sc_add(6, 0,3,5,6,7,10,0,0);   sc_let(0,2,3,4,4,6,0,0);  // Minor Blues
sc_add(6, 0,2,4,6,8,10,0,0);   sc_let(0,1,2,3,4,5,0,0);  // Whole Tone
sc_add(8, 0,2,3,5,6,8,9,11);   sc_let(0,1,2,3,4,5,5,6);  // Diminished W-H
sc_add(8, 0,1,3,4,6,7,9,10);   sc_let(0,1,2,2,3,4,5,6);  // Diminished H-W

n_roots = 0;
root_add(0, 0); root_add(0, 1); root_add(1,-1); root_add(1, 0); root_add(1, 1);
root_add(2,-1); root_add(2, 0); root_add(3, 0); root_add(3, 1); root_add(4,-1);
root_add(4, 0); root_add(4, 1); root_add(5,-1); root_add(5, 0); root_add(5, 1);
root_add(6,-1); root_add(6, 0); root_add(0,-1);

// Chords. The order here must match #chord_names and #chord_syms exactly;
// init_check() below catches it if a line is ever added to one and not the
// others. Families: 1 triads, 2 sixths and sevenths, 3 extended, 4 altered,
// 5 suspended and added, 6 quartal and cluster, 7 named. Family 0 is the
// diatonic set, which is built from the scale at generation time instead.
n_chords = 0;
chord_add(cm( 0, 4, 7,-1,-1,-1,-1), 1);  // Major
chord_add(cm( 0, 3, 7,-1,-1,-1,-1), 1);  // Minor
chord_add(cm( 0, 3, 6,-1,-1,-1,-1), 1);  // Diminished
chord_add(cm( 0, 4, 8,-1,-1,-1,-1), 1);  // Augmented
chord_add(cm( 0, 4, 6,-1,-1,-1,-1), 1);  // Flat Five
chord_add(cm( 0, 7,-1,-1,-1,-1,-1), 1);  // Fifth (power chord)

chord_add(cm( 0, 4, 7, 9,-1,-1,-1), 2);  // Sixth
chord_add(cm( 0, 3, 7, 9,-1,-1,-1), 2);  // Minor Sixth
chord_add(cm( 0, 4, 7, 9,14,-1,-1), 2);  // Six-Nine
chord_add(cm( 0, 3, 7, 9,14,-1,-1), 2);  // Minor Six-Nine
chord_add(cm( 0, 4, 7,10,-1,-1,-1), 2);  // Dominant Seventh
chord_add(cm( 0, 4, 7,11,-1,-1,-1), 2);  // Major Seventh
chord_add(cm( 0, 3, 7,10,-1,-1,-1), 2);  // Minor Seventh
chord_add(cm( 0, 3, 7,11,-1,-1,-1), 2);  // Minor-Major Seventh
chord_add(cm( 0, 3, 6,10,-1,-1,-1), 2);  // Half-Diminished Seventh
chord_add(cm( 0, 3, 6, 9,-1,-1,-1), 2);  // Diminished Seventh
chord_add(cm( 0, 4, 8,10,-1,-1,-1), 2);  // Augmented Seventh
chord_add(cm( 0, 4, 8,11,-1,-1,-1), 2);  // Augmented Major Seventh
chord_add(cm( 0, 4, 6,10,-1,-1,-1), 2);  // Seventh Flat Five

chord_add(cm( 0, 4, 7,10,14,-1,-1), 3);  // Ninth
chord_add(cm( 0, 4, 7,11,14,-1,-1), 3);  // Major Ninth
chord_add(cm( 0, 3, 7,10,14,-1,-1), 3);  // Minor Ninth
chord_add(cm( 0, 3, 7,11,14,-1,-1), 3);  // Minor-Major Ninth
chord_add(cm( 0, 4, 7,10,14,17,-1), 3);  // Eleventh
chord_add(cm( 0, 4, 7,11,14,17,-1), 3);  // Major Eleventh
chord_add(cm( 0, 3, 7,10,14,17,-1), 3);  // Minor Eleventh
chord_add(cm( 0, 4, 7,10,14,17,21), 3);  // Thirteenth
chord_add(cm( 0, 4, 7,11,14,17,21), 3);  // Major Thirteenth
chord_add(cm( 0, 3, 7,10,14,17,21), 3);  // Minor Thirteenth

chord_add(cm( 0, 4, 7,10,13,-1,-1), 4);  // Seventh Flat Nine
chord_add(cm( 0, 4, 7,10,15,-1,-1), 4);  // Seventh Sharp Nine
chord_add(cm( 0, 4, 7,10,18,-1,-1), 4);  // Seventh Sharp Eleven
chord_add(cm( 0, 4, 7,10,20,-1,-1), 4);  // Seventh Flat Thirteen
chord_add(cm( 0, 4, 8,10,13,-1,-1), 4);  // Seventh Sharp Five Flat Nine
chord_add(cm( 0, 4, 8,10,15,-1,-1), 4);  // Seventh Sharp Five Sharp Nine
chord_add(cm( 0, 4, 6,10,13,-1,-1), 4);  // Seventh Flat Five Flat Nine
chord_add(cm( 0, 4, 8,10,13,15,-1), 4);  // Altered Dominant
chord_add(cm( 0, 4, 7,10,13,21,-1), 4);  // Thirteenth Flat Nine
chord_add(cm( 0, 4, 7,11,18,-1,-1), 4);  // Major Seventh Sharp Eleven
chord_add(cm( 0, 3, 6,10,14,-1,-1), 4);  // Minor Ninth Flat Five

chord_add(cm( 0, 2, 7,-1,-1,-1,-1), 5);  // Suspended Second
chord_add(cm( 0, 5, 7,-1,-1,-1,-1), 5);  // Suspended Fourth
chord_add(cm( 0, 5, 7,10,-1,-1,-1), 5);  // Seventh Suspended Fourth
chord_add(cm( 0, 5, 7,10,14,-1,-1), 5);  // Ninth Suspended Fourth
chord_add(cm( 0, 5, 7,11,-1,-1,-1), 5);  // Major Seventh Suspended Fourth
chord_add(cm( 0, 4, 7,14,-1,-1,-1), 5);  // Added Ninth
chord_add(cm( 0, 3, 7,14,-1,-1,-1), 5);  // Minor Added Ninth
chord_add(cm( 0, 4, 5, 7,-1,-1,-1), 5);  // Added Fourth
chord_add(cm( 0, 4, 7,17,-1,-1,-1), 5);  // Added Eleventh
chord_add(cm( 0, 4, 7,21,-1,-1,-1), 5);  // Added Thirteenth

chord_add(cm( 0, 5,10,-1,-1,-1,-1), 6);  // Quartal Triad
chord_add(cm( 0, 5,10,15,-1,-1,-1), 6);  // Quartal Tetrad
chord_add(cm( 0, 7,14,-1,-1,-1,-1), 6);  // Quintal Triad
chord_add(cm( 0, 2, 4,-1,-1,-1,-1), 6);  // Whole-Tone Trichord
chord_add(cm( 0, 1, 2,-1,-1,-1,-1), 6);  // Chromatic Cluster
chord_add(cm( 0, 2, 4, 5,-1,-1,-1), 6);  // Diatonic Cluster

chord_add(cm( 0, 6,10,16,21,26,-1), 7);  // Mystic (Scriabin)
chord_add(cm( 0, 4, 6, 7,10,13,-1), 7);  // Petrushka
chord_add(cm( 0, 6,10,15,-1,-1,-1), 7);  // Tristan
chord_add(cm( 0, 5,10,15,19,-1,-1), 7);  // So What
chord_add(cm( 0, 5, 6, 7,-1,-1,-1), 7);  // Dream
chord_add(cm( 0, 1, 6,-1,-1,-1,-1), 7);  // Viennese Trichord
chord_add(cm( 0, 1, 4, 5, 8, 9,-1), 7);  // Ode-to-Napoleon
chord_add(cm( 0, 4,10,-1,-1,-1,-1), 7);  // Italian Sixth
chord_add(cm( 0, 4, 6,10,-1,-1,-1), 7);  // French Sixth
chord_add(cm( 0, 4, 7,10,-1,-1,-1), 7);  // German Sixth

// The long-form chord names, in the same order as the table above. Split over
// several strcat calls only so the source stays readable.
strcpy(#chord_names, "Major|Minor|Diminished|Augmented|Flat Five|Fifth (Power)");
strcat(#chord_names, "|Sixth|Minor Sixth|Six-Nine|Minor Six-Nine|Dominant Seventh|Major Seventh|Minor Seventh|Minor-Major Seventh|Half-Diminished Seventh|Diminished Seventh|Augmented Seventh|Augmented Major Seventh|Seventh Flat Five");
strcat(#chord_names, "|Ninth|Major Ninth|Minor Ninth|Minor-Major Ninth|Eleventh|Major Eleventh|Minor Eleventh|Thirteenth|Major Thirteenth|Minor Thirteenth");
strcat(#chord_names, "|Seventh Flat Nine|Seventh Sharp Nine|Seventh Sharp Eleven|Seventh Flat Thirteen|Seventh Sharp Five Flat Nine|Seventh Sharp Five Sharp Nine|Seventh Flat Five Flat Nine|Altered Dominant|Thirteenth Flat Nine|Major Seventh Sharp Eleven|Minor Ninth Flat Five");
strcat(#chord_names, "|Suspended Second|Suspended Fourth|Seventh Suspended Fourth|Ninth Suspended Fourth|Major Seventh Suspended Fourth|Added Ninth|Minor Added Ninth|Added Fourth|Added Eleventh|Added Thirteenth");
strcat(#chord_names, "|Quartal Triad|Quartal Tetrad|Quintal Triad|Whole-Tone Trichord|Chromatic Cluster|Diatonic Cluster");
strcat(#chord_names, "|Mystic (Scriabin)|Petrushka|Tristan|So What|Dream|Viennese Trichord|Ode-to-Napoleon|Italian Sixth|French Sixth|German Sixth");

strcpy(#chord_syms, "maj|m|dim|aug|b5|5");
strcat(#chord_syms, "|6|m6|6/9|m6/9|7|maj7|m7|mMaj7|m7b5|dim7|7#5|maj7#5|7b5");
strcat(#chord_syms, "|9|maj9|m9|mMaj9|11|maj11|m11|13|maj13|m13");
strcat(#chord_syms, "|7b9|7#9|7#11|7b13|7#5b9|7#5#9|7b5b9|7alt|13b9|maj7#11|m9b5");
strcat(#chord_syms, "|sus2|sus4|7sus4|9sus4|maj7sus4|add9|m(add9)|add4|add11|add13");
strcat(#chord_syms, "|Q4/3|Q4/4|Q5/3|WT3|cluster|dia-cl");
strcat(#chord_syms, "|Mystic|Petrushka|Tristan|So What|Dream|Vienna|Napoleon|It+6|Fr+6|Ger+6");

strcpy(#scale_names, "Major|Minor|Harm Minor|Ionian|Dorian|Phrygian|Lydian|Mixolydian|Aeolian|Maj Pent|Min Pent|Maj Blues|Min Blues|Whole Tone|Dim W-H|Dim H-W");
strcpy(#root_names,  "C|C#|Db|D|D#|Eb|E|F|F#|Gb|G|G#|Ab|A|A#|Bb|B|Cb");
strcpy(#cat_names,   "Chord|Arpeggio|Run|Melody|Bass|Drums");
strcpy(#fam_names,   "Diatonic|Triads|6ths & 7ths|Extended|Altered|Sus & Add|Quartal|Named");
strcpy(#dia_names,   "Triad|7th|9th|11th|13th|6th|sus2|sus4|5th");
strcpy(#pat_names,   "Up|Down|Up/Down|Down/Up|Random|Converge|Diverge|1-3-5|3-1-5|5-3-1|3-5-1|1-5-3|5-1-3");
strcpy(#rate_names,  "1/64|1/32|1/16|1/8|1/4|1/2|1/1");
strcpy(#mod_names,   "Straight|Triplet|Dotted");
strcpy(#mel_names,   "2nd|3rd|4th|5th|6th|7th|Octave");
strcpy(#shape_names, "Single|Return|Fill");
strcpy(#drp_names,   "Kick|Snare|Closed HH|Open HH|Crash|Ride|Low Tom|Mid Tom|High Tom");
strcpy(#drs_names,   "One Hit|Four on the Floor|One & Three|Two & Four|And of Two|Two Step|Off-beats|Every 8th|Every 16th");
strcpy(#btone_names, "Root|3rd|5th|7th");
strcpy(#inv_names,   "Root|1st|2nd|3rd");
strcpy(#numerals,    "I|II|III|IV|V|VI|VII|VIII|i|ii|iii|iv|v|vi|vii|viii");
strcpy(#degree_names,"Tonic|Supertonic|Mediant|Subdominant|Dominant|Submediant|Leading Tone|Octave");
strcpy(#pc_sharp,    "C|C#|D|D#|E|F|F#|G|G#|A|A#|B");
strcpy(#pc_flat,     "C|Db|D|Eb|E|F|Gb|G|Ab|A|Bb|B");

n_scale_names = idx_build(#scale_names, IDX_SCL);
n_root_names  = idx_build(#root_names,  IDX_ROOT);
n_cats        = idx_build(#cat_names,   IDX_CAT);
n_fams        = idx_build(#fam_names,   IDX_FAM);
n_chord_names = idx_build(#chord_names, IDX_CHN);
n_chord_syms  = idx_build(#chord_syms,  IDX_CHS);
n_dia         = idx_build(#dia_names,   IDX_DIA);
n_pats        = idx_build(#pat_names,   IDX_PAT);
n_rates       = idx_build(#rate_names,  IDX_RATE);
n_mods        = idx_build(#mod_names,   IDX_MOD);
n_mels        = idx_build(#mel_names,   IDX_MEL);
n_shapes      = idx_build(#shape_names, IDX_SHP);
n_drp         = idx_build(#drp_names,   IDX_DRP);
n_drs         = idx_build(#drs_names,   IDX_DRS);
n_btone       = idx_build(#btone_names, IDX_BTONE);
n_invs        = idx_build(#inv_names,   IDX_INV);
idx_build(#numerals, IDX_NUM);
idx_build(#degree_names, IDX_NUM + 64);
idx_build(#pc_sharp, IDX_PCS);
idx_build(#pc_flat, IDX_PCF);

// If a chord is ever added to the table but not to one of the name strings the
// UI would silently label everything after it wrongly, so say so instead.
data_ok = (n_chord_names == n_chords) && (n_chord_syms == n_chords) &&
          (n_scale_names == n_scales) && (n_root_names == n_roots);

// Diatonic stacks, as offsets in scale degrees from the chosen degree. These
// are the chords the key hands you for free, so they are the default family.
function dia_add(cnt a b c d e f g) (
  DIA_CNT[n_dia_shapes] = cnt;
  DIA_OFF[n_dia_shapes*8+0] = a; DIA_OFF[n_dia_shapes*8+1] = b;
  DIA_OFF[n_dia_shapes*8+2] = c; DIA_OFF[n_dia_shapes*8+3] = d;
  DIA_OFF[n_dia_shapes*8+4] = e; DIA_OFF[n_dia_shapes*8+5] = f;
  DIA_OFF[n_dia_shapes*8+6] = g;
  n_dia_shapes += 1;
);
n_dia_shapes = 0;
dia_add(3, 0,2,4, 0,0,0,0);        // Triad
dia_add(4, 0,2,4,6, 0,0,0);        // 7th
dia_add(5, 0,2,4,6,8, 0,0);        // 9th
dia_add(6, 0,2,4,6,8,10, 0);       // 11th
dia_add(7, 0,2,4,6,8,10,12);       // 13th
dia_add(4, 0,2,4,5, 0,0,0);        // 6th
dia_add(3, 0,1,4, 0,0,0,0);        // sus2
dia_add(3, 0,3,4, 0,0,0,0);        // sus4
dia_add(2, 0,4, 0,0,0,0,0);        // 5th

// ---------------------------------------------------------------------------
// State. Nothing lives in a slider: @serialize carries all of it, so the FX
// window stays the custom UI and nothing else.
// ---------------------------------------------------------------------------
sel_root    = 0;    // index into the root list
sel_scale   = 0;    // index into the scale list
sel_degree  = 0;    // 0-based scale degree
sel_cat     = 0;    // 0 chord, 1 arpeggio, 2 run, 3 melody, 4 bass, 5 drums
sel_fam     = 0;    // chord family, 0 = diatonic
sel_dia     = 0;    // which diatonic stack, when sel_fam is 0
sel_chord   = 0;    // which table chord, when sel_fam is not 0
sel_inv     = 0;    // inversion
sel_oct     = 0;    // octave transpose for pitched blocks
sel_pat     = 0;    // arpeggio pattern
sel_rundir  = 0;    // run direction
sel_rate    = 3;    // 1/8
sel_mod     = 0;    // straight
sel_octaves = 1;
sel_bars    = 1;
sel_vel     = 100;
sel_gate    = 90;   // percent of the step the note is held for
sel_mel     = 0;    // melodic interval
sel_meldir  = 0;    // 0 up, 1 down
sel_shape   = 0;    // single, return, fill
sel_btone   = 0;    // which chord tone the bass plays
sel_boct    = -1;   // bass octave offset
sel_drp     = 0;    // drum piece
sel_drs     = 1;    // drum style
base_oct    = 4;    // C4 = 60
midi_ch     = 0;
loop_on     = 0;

bar_beats   = 4;
dirty       = 1;
n_notes     = 0;
total_beats = 4;

// ---------------------------------------------------------------------------
// Music theory
// ---------------------------------------------------------------------------

function scale_len() ( SCL_N[sel_scale] );

// The MIDI pitch of scale degree d, counting past the top of the scale into
// the octave above (and below zero into the octave below).
function scale_pitch(d) local(n oct k) (
  n = SCL_N[sel_scale];
  oct = floor(d / n);
  k = d - oct * n;
  (LETTER_PC[ROOT_LT[sel_root]] + ROOT_ACC[sel_root] + 120) % 12
    + (base_oct + 1) * 12 + SCL_IV[sel_scale*8 + k] + oct * 12;
);

// Writes the name of scale degree d into s, spelled for the key: the seventh
// of F# major comes out E#, not F.
function note_name(s d) local(n oct k letter pc acc c) (
  n = SCL_N[sel_scale];
  oct = floor(d / n);
  k = d - oct * n;
  letter = (ROOT_LT[sel_root] + SCL_LT[sel_scale*8 + k]) % 7;
  pc = scale_pitch(d) % 12;
  acc = pc - LETTER_PC[letter];
  acc >  6 ? ( acc -= 12; );
  acc < -6 ? ( acc += 12; );
  c = letter < 5 ? 67 + letter : 60 + letter;   // C D E F G then A B
  sprintf(s, "%c", c);
  acc == -2 ? strcat(s, "bb") : acc == -1 ? strcat(s, "b") :
  acc ==  1 ? strcat(s, "#")  : acc ==  2 ? strcat(s, "x") : 0;
  s;
);

// 0 major, 1 minor, 2 diminished, 3 augmented, 4 anything else. Read off the
// scale rather than assumed, so the modes and the blues scales come out right.
function degree_quality(d) local(r3 r5 p) (
  p = scale_pitch(d);
  r3 = scale_pitch(d + 2) - p;
  r5 = scale_pitch(d + 4) - p;
  r3 == 4 && r5 == 7 ? 0 : r3 == 3 && r5 == 7 ? 1 :
  r3 == 3 && r5 == 6 ? 2 : r3 == 4 && r5 == 8 ? 3 : 4;
);

// The Roman numeral for degree d, cased and marked for its quality.
function degree_numeral(s d) local(q) (
  q = degree_quality(d);
  idx_get(s, #numerals, IDX_NUM, (q == 1 || q == 2) ? 8 + d : d);
  q == 2 ? strcat(s, "\xC2\xB0") : q == 3 ? strcat(s, "+") : 0;
  s;
);

// The degree sign is fine on screen but not in a filename, so the name the
// block travels under spells the quality out instead.
function degree_numeral_ascii(s d) local(q) (
  q = degree_quality(d);
  idx_get(s, #numerals, IDX_NUM, (q == 1 || q == 2) ? 8 + d : d);
  q == 2 ? strcat(s, "dim") : q == 3 ? strcat(s, "aug") : 0;
  s;
);

// Tonic, Supertonic and the rest. Only the seven-note scales have these names;
// anything else just gets numbered. The seventh is a leading tone only when it
// really does lean on the tonic a semitone above.
function degree_title(s d) local(n) (
  n = SCL_N[sel_scale];
  n == 7 ? (
    idx_get(s, #degree_names, IDX_NUM + 64, d);
    d == 6 && (scale_pitch(7) - scale_pitch(6)) != 1 ? ( strcpy(s, "Subtonic"); );
  ) : sprintf(s, "Degree %d", d + 1);
  s;
);

// ---------------------------------------------------------------------------
// Generators. Every block ends up in NOTES as (startQN, lenQN, pitch, velocity)
// with the whole block total_beats long, and nothing downstream needs to know
// which kind of block it came from.
// ---------------------------------------------------------------------------

function note_add(st len p v) (
  n_notes < MAXNOTES && p >= 0 && p <= 127 ? (
    NOTES[n_notes*4]   = st;
    NOTES[n_notes*4+1] = max(len, 0.015);
    NOTES[n_notes*4+2] = p | 0;
    NOTES[n_notes*4+3] = max(1, min(127, v | 0));
    n_notes += 1;
  );
);

// One step of the chosen rate, in quarter notes.
function rate_beats() local(b) (
  b = (2 ^ sel_rate) / 16;
  sel_mod == 1 ? b * 2 / 3 : sel_mod == 2 ? b * 1.5 : b;
);

// Fills TONES with the chord's pitches and returns how many there are. inv
// lifts that many of the lowest voices up an octave.
function chord_tones(inv) local(i j cnt base mask rot t) (
  cnt = 0;
  sel_fam == 0 ? (
    i = 0;
    while (i < DIA_CNT[sel_dia]) (
      TONES[cnt] = scale_pitch(sel_degree + DIA_OFF[sel_dia*8 + i]) + sel_oct*12;
      cnt += 1; i += 1;
    );
  ) : (
    base = scale_pitch(sel_degree) + sel_oct*12;
    mask = CH_MASK[sel_chord];
    i = 0;
    while (i < 32) (
      mask & (2^i) ? ( TONES[cnt] = base + i; cnt += 1; );
      i += 1;
    );
  );
  rot = min(inv, cnt - 1);
  i = 0;
  while (i < rot) (
    t = TONES[0] + 12;
    j = 0; while (j < cnt - 1) ( TONES[j] = TONES[j+1]; j += 1; );
    TONES[cnt-1] = t;
    i += 1;
  );
  cnt;
);

// Lays the m pitches in POOL out in playing order into SEQ. Returns the length.
function apply_dir(m dir) local(i j k t n lo hi) (
  n = 0;
  dir == 0 ? ( i = 0; while (i < m) ( SEQ[n] = POOL[i]; n += 1; i += 1; ); )
: dir == 1 ? ( i = m-1; while (i >= 0) ( SEQ[n] = POOL[i]; n += 1; i -= 1; ); )
: dir == 2 ? ( i = 0;   while (i < m)  ( SEQ[n] = POOL[i]; n += 1; i += 1; );
               i = m-2; while (i > 0)  ( SEQ[n] = POOL[i]; n += 1; i -= 1; ); )
: dir == 3 ? ( i = m-1; while (i >= 0) ( SEQ[n] = POOL[i]; n += 1; i -= 1; );
               i = 1;   while (i < m-1)( SEQ[n] = POOL[i]; n += 1; i += 1; ); )
: dir == 4 ? ( // Random, but a shuffle rather than free picks, so every pitch
               // of the chord still gets its turn before any repeats.
               i = 0; while (i < m) ( SEQ[i] = POOL[i]; i += 1; ); n = m;
               i = m-1;
               while (i > 0) (
                 j = floor(rand(1) * (i + 1));
                 t = SEQ[i]; SEQ[i] = SEQ[j]; SEQ[j] = t;
                 i -= 1;
               ); )
: dir == 5 ? ( // Converge: outside in.
               lo = 0; hi = m-1;
               while (lo <= hi) (
                 SEQ[n] = POOL[lo]; n += 1; lo += 1;
                 lo <= hi ? ( SEQ[n] = POOL[hi]; n += 1; hi -= 1; );
               ); )
: dir == 6 ? ( // Diverge: middle out.
               k = floor((m-1) / 2); lo = k; hi = k+1;
               while (lo >= 0 || hi < m) (
                 lo >= 0 ? ( SEQ[n] = POOL[lo]; n += 1; lo -= 1; );
                 hi < m  ? ( SEQ[n] = POOL[hi]; n += 1; hi += 1; );
               ); )
: ( i = 0; while (i < m) ( SEQ[n] = POOL[i]; n += 1; i += 1; ); );
  n;
);

// Walks SEQ over the length of the block, one pitch per step.
function lay_steps(nseq step) local(pos idx len) (
  nseq > 0 ? (
    pos = 0; idx = 0;
    while (pos < total_beats - 0.0001 && n_notes < MAXNOTES) (
      len = min(step * sel_gate * 0.01, total_beats - pos);
      note_add(pos, len, SEQ[idx % nseq], sel_vel);
      idx += 1; pos += step;
    );
  );
);

function gen_chord() local(cnt i len) (
  cnt = chord_tones(sel_inv);
  total_beats = bar_beats * sel_bars;
  len = total_beats * sel_gate * 0.01;
  i = 0;
  while (i < cnt) ( note_add(0, len, TONES[i], sel_vel); i += 1; );
);

function gen_arp() local(cnt m o i j nseq perm p0 p1 p2) (
  cnt = chord_tones(sel_inv);
  total_beats = bar_beats * sel_bars;
  cnt > 0 ? (
    sel_pat < 7 ? (
      // A direction: every chord tone across the octave span, reordered.
      m = 0; o = 0;
      while (o < sel_octaves) (
        i = 0;
        while (i < cnt) ( m < 128 ? ( POOL[m] = TONES[i] + o*12; m += 1; ); i += 1; );
        o += 1;
      );
      nseq = apply_dir(m, sel_pat);
    ) : (
      // A fixed shape: the permutation reorders the lowest three voices, any
      // extension above them follows in order, and the cell climbs an octave
      // at a time.
      perm = sel_pat - 7;
      p0 = perm == 0 ? 0 : perm == 1 ? 1 : perm == 2 ? 2 : perm == 3 ? 1 : perm == 4 ? 0 : 2;
      p1 = perm == 0 ? 1 : perm == 1 ? 0 : perm == 2 ? 1 : perm == 3 ? 2 : perm == 4 ? 2 : 0;
      p2 = perm == 0 ? 2 : perm == 1 ? 2 : perm == 2 ? 0 : perm == 3 ? 0 : perm == 4 ? 1 : 1;
      nseq = 0; o = 0;
      while (o < sel_octaves) (
        cnt >= 3 ? (
          SEQ[nseq] = TONES[p0] + o*12; nseq += 1;
          SEQ[nseq] = TONES[p1] + o*12; nseq += 1;
          SEQ[nseq] = TONES[p2] + o*12; nseq += 1;
          j = 3;
        ) : ( j = 0; );
        while (j < cnt) ( nseq < 128 ? ( SEQ[nseq] = TONES[j] + o*12; nseq += 1; ); j += 1; );
        o += 1;
      );
    );
    lay_steps(nseq, rate_beats());
  );
);

function gen_run() local(m i n nseq) (
  n = SCL_N[sel_scale];
  total_beats = bar_beats * sel_bars;
  m = 0; i = 0;
  // Inclusive of the octave above, so a one-octave run lands back on the tonic.
  while (i <= n * sel_octaves && m < 128) (
    POOL[m] = scale_pitch(sel_degree + i) + sel_oct*12; m += 1; i += 1;
  );
  nseq = apply_dir(m, sel_rundir);
  lay_steps(nseq, rate_beats());
);

function gen_melody() local(steps dir step len i a b) (
  // A 2nd is one scale step, a 3rd is two, and so on; the octave is however
  // many steps this particular scale takes to get there.
  steps = sel_mel == 6 ? SCL_N[sel_scale] : sel_mel + 1;
  dir  = sel_meldir ? -1 : 1;
  step = rate_beats();
  len  = step * sel_gate * 0.01;
  a = scale_pitch(sel_degree) + sel_oct*12;
  b = scale_pitch(sel_degree + dir*steps) + sel_oct*12;
  sel_shape == 0 ? (
    note_add(0, len, a, sel_vel);
    note_add(step, len, b, sel_vel);
    total_beats = step * 2;
  ) : sel_shape == 1 ? (
    note_add(0, len, a, sel_vel);
    note_add(step, len, b, sel_vel);
    note_add(step*2, len, a, sel_vel);
    total_beats = step * 3;
  ) : (
    i = 0;
    while (i <= steps) (
      note_add(i*step, len, scale_pitch(sel_degree + dir*i) + sel_oct*12, sel_vel);
      i += 1;
    );
    total_beats = step * (steps + 1);
  );
);

function gen_bass() local(cnt p step pos len idx) (
  // The bass reads the chord as it is stacked, so inversion is ignored here:
  // voice 0 is the root, 1 the third, 2 the fifth, 3 the seventh.
  cnt = chord_tones(0);
  total_beats = bar_beats * sel_bars;
  step = rate_beats();
  cnt > 0 ? (
    idx = min(sel_btone, cnt - 1);
    p = TONES[idx] + sel_boct*12;
    pos = 0;
    while (pos < total_beats - 0.0001 && n_notes < MAXNOTES) (
      len = min(step * sel_gate * 0.01, total_beats - pos);
      note_add(pos, len, p, sel_vel);
      pos += step;
    );
  );
);

// Where the hits fall inside one 4/4 bar. Anything past the end of a shorter
// bar is dropped by gen_drums.
function drum_hits() local(n i) (
  n = 0;
  sel_drs == 0 ? ( HITS[0] = 0; n = 1; )
: sel_drs == 1 ? ( HITS[0]=0; HITS[1]=1; HITS[2]=2; HITS[3]=3; n = 4; )
: sel_drs == 2 ? ( HITS[0]=0; HITS[1]=2; n = 2; )
: sel_drs == 3 ? ( HITS[0]=1; HITS[1]=3; n = 2; )
: sel_drs == 4 ? ( HITS[0]=1.5; n = 1; )
: sel_drs == 5 ? ( HITS[0]=0; HITS[1]=1.5; HITS[2]=3; n = 3; )
: sel_drs == 6 ? ( HITS[0]=0.5; HITS[1]=1.5; HITS[2]=2.5; HITS[3]=3.5; n = 4; )
: sel_drs == 7 ? ( i=0; while (i < 8)  ( HITS[i] = i*0.5;  i += 1; ); n = 8; )
: (               i=0; while (i < 16) ( HITS[i] = i*0.25; i += 1; ); n = 16; );
  n;
);

function gen_drums() local(n i b p) (
  total_beats = bar_beats * sel_bars;
  n = drum_hits();
  p = DRUM_NOTE[sel_drp];
  b = 0;
  while (b < sel_bars) (
    i = 0;
    while (i < n) (
      HITS[i] < bar_beats ? ( note_add(b*bar_beats + HITS[i], 0.1, p, sel_vel); );
      i += 1;
    );
    b += 1;
  );
);

function chord_label(s) (
  sel_fam == 0 ? idx_get(s, #dia_names,  IDX_DIA, sel_dia)
               : idx_get(s, #chord_syms, IDX_CHS, sel_chord);
);

function block_name(s) (
  idx_get(#t1, #root_names,  IDX_ROOT, sel_root);
  idx_get(#t2, #scale_names, IDX_SCL,  sel_scale);
  degree_numeral_ascii(#t3, sel_degree);
  sel_cat == 0 ? (
    chord_label(#t4);
    sprintf(s, "%s %s %s Chord %s", #t1, #t2, #t3, #t4);
  ) : sel_cat == 1 ? (
    chord_label(#t4); idx_get(#t5, #pat_names, IDX_PAT, sel_pat);
    idx_get(#t6, #rate_names, IDX_RATE, sel_rate);
    sprintf(s, "%s %s %s Arp %s %s %s", #t1, #t2, #t3, #t4, #t5, #t6);
  ) : sel_cat == 2 ? (
    idx_get(#t4, #pat_names, IDX_PAT, sel_rundir);
    idx_get(#t5, #rate_names, IDX_RATE, sel_rate);
    sprintf(s, "%s %s %s Run %s %s", #t1, #t2, #t3, #t4, #t5);
  ) : sel_cat == 3 ? (
    idx_get(#t4, #mel_names, IDX_MEL, sel_mel);
    idx_get(#t5, #shape_names, IDX_SHP, sel_shape);
    sprintf(s, "%s %s %s Melody %s %s %s", #t1, #t2, #t3,
            sel_meldir ? "Down" : "Up", #t4, #t5);
  ) : sel_cat == 4 ? (
    idx_get(#t4, #btone_names, IDX_BTONE, sel_btone);
    idx_get(#t5, #rate_names, IDX_RATE, sel_rate);
    sprintf(s, "%s %s %s Bass %s %s", #t1, #t2, #t3, #t4, #t5);
  ) : (
    idx_get(#t4, #drp_names, IDX_DRP, sel_drp);
    idx_get(#t5, #drs_names, IDX_DRS, sel_drs);
    sprintf(s, "Drum %s %s", #t4, #t5);
  );
  s;
);

function regenerate() (
  n_notes = 0;
  total_beats = bar_beats * sel_bars;
  sel_cat == 0 ? gen_chord() : sel_cat == 1 ? gen_arp()    : sel_cat == 2 ? gen_run()
: sel_cat == 3 ? gen_melody(): sel_cat == 4 ? gen_bass()   : gen_drums();
  block_name(#block_name);
  dirty = 0;
);

regenerate();

function all_off() ( midisend(0, $xB0 + midi_ch, 123, 0); );

// Hands the current block to the bridge. cmd 1 inserts it at the edit cursor,
// cmd 2 writes it into the drag bin as a .mid file.
function push_gmem(cmd) local(i n c) (
  n = min(n_notes, MAXNOTES);
  i = 0;
  while (i < n*4) ( gmem[GM_NOTES + i] = NOTES[i]; i += 1; );
  gmem[GM_NCOUNT] = n;
  gmem[GM_BEATS]  = total_beats;
  c = min(strlen(#block_name), 96);
  i = 0;
  while (i < c) ( gmem[GM_NAME + i] = str_getchar(#block_name, i, 'cu'); i += 1; );
  gmem[GM_NAMELEN] = c;
  gmem[GM_STATUS]  = -1;
  gmem[GM_CMD]     = cmd;
  req_seq += 1;
  gmem[GM_SEQ] = req_seq;
);

@serialize
ser_ver = 1;
file_var(0, ser_ver);
file_var(0, sel_root);   file_var(0, sel_scale);  file_var(0, sel_degree);
file_var(0, sel_cat);    file_var(0, sel_fam);    file_var(0, sel_dia);
file_var(0, sel_chord);  file_var(0, sel_inv);    file_var(0, sel_oct);
file_var(0, sel_pat);    file_var(0, sel_rundir); file_var(0, sel_rate);
file_var(0, sel_mod);    file_var(0, sel_octaves);file_var(0, sel_bars);
file_var(0, sel_vel);    file_var(0, sel_gate);   file_var(0, sel_mel);
file_var(0, sel_meldir); file_var(0, sel_shape);  file_var(0, sel_btone);
file_var(0, sel_boct);   file_var(0, sel_drp);    file_var(0, sel_drs);
file_var(0, base_oct);   file_var(0, midi_ch);    file_var(0, loop_on);
// file_avail is negative while writing, so this only fires on the way back in.
file_avail(0) >= 0 ? ( dirty = 1; );

@block

ts_num > 0 && ts_denom > 0 ? ( bar_beats = ts_num * 4 / ts_denom; ) : ( bar_beats = 4; );
bar_beats != last_bar_beats ? ( last_bar_beats = bar_beats; dirty = 1; );
cur_tempo = max(tempo, 1);
// Changing a setting mid-audition rewrites the notes under the playhead, so
// let go of anything sounding before the ground moves.
dirty ? ( play_on ? ( all_off(); ); regenerate(); );

// The bridge counts up a heartbeat while it runs; if it stops moving for two
// seconds the UI says so rather than letting Insert quietly do nothing.
gmem[GM_HB] != last_hb ? ( last_hb = gmem[GM_HB]; bridge_age = 0; )
                       : ( bridge_age += samplesblock; );
bridge_up = bridge_age < srate * 2;
gmem[GM_ACK] == req_seq && req_seq > 0 ? ( last_status = gmem[GM_STATUS]; );

req_cmd > 0 ? ( push_gmem(req_cmd); req_cmd = 0; );
req_alloff ? ( all_off(); req_alloff = 0; );

play_on ? (
  spb = srate * 60 / cur_tempo;          // samples per quarter note
  b0 = play_pos / spb;
  b1 = (play_pos + samplesblock) / spb;
  i = 0;
  while (i < n_notes) (
    st = NOTES[i*4];
    en = st + NOTES[i*4+1];
    st >= b0 && st < b1 ?
      midisend(min(samplesblock-1, max(0, floor((st-b0)*spb))),
               $x90 + midi_ch, NOTES[i*4+2], NOTES[i*4+3]);
    en >= b0 && en < b1 ?
      midisend(min(samplesblock-1, max(0, floor((en-b0)*spb))),
               $x80 + midi_ch, NOTES[i*4+2], 0);
    i += 1;
  );
  play_pos += samplesblock;
  play_pos / spb >= total_beats ? (
    all_off();
    loop_on ? ( play_pos = 0; ) : ( play_on = 0; );
  );
);

@gfx 1000 620

// ---------------------------------------------------------------------------
// Drawing helpers
// ---------------------------------------------------------------------------
function setc(r g b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function rectf(x y w h) ( gfx_rect(x, y, w, h, 1); );
function recto(x y w h) ( gfx_rect(x, y, w, h, 0); );

function ctext(x y w h s) local(tw th) (
  gfx_measurestr(s, tw, th);
  gfx_x = (x + (w - tw) * 0.5) | 0;
  gfx_y = (y + (h - th) * 0.5) | 0;
  gfx_drawstr(s);
);

function ltext(x y s) ( gfx_x = x; gfx_y = y; gfx_drawstr(s); );

function label(x y s) (
  gfx_setfont(3);
  setc(0.48, 0.50, 0.57);
  ltext(x, y, s);
  gfx_setfont(1);
);

function hit(x y w h) ( mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h );

// Every button is a radio button somewhere, so selection is drawn rather than
// toggled here; the caller owns the state.
function btn(x y w h s sel) local(hov r) (
  hov = hit(x, y, w, h);
  sel ? setc(0.22, 0.50, 0.90) : hov ? setc(0.27, 0.29, 0.34) : setc(0.19, 0.20, 0.24);
  rectf(x, y, w, h);
  setc(0.10, 0.11, 0.13); recto(x, y, w, h);
  sel ? setc(1, 1, 1) : setc(0.80, 0.82, 0.88);
  ctext(x, y, w, h, s);
  r = hov && g_click;
  r ? ( g_click = 0; );
  r;
);

// A row of buttons taken from a '|' separated string. Returns the index
// clicked, or -1.
function btn_row(x y w h gap s tbl n selv) local(i r) (
  r = -1; i = 0;
  while (i < n) (
    idx_get(#tmp, s, tbl, i);
    btn(x + i*(w+gap), y, w, h, #tmp, selv == i) ? ( r = i; );
    i += 1;
  );
  r;
);

function stepper(x y w h val) local(d) (
  d = 0;
  btn(x, y, 20, h, "-", 0) ? ( d = -1; );
  setc(0.13, 0.14, 0.17); rectf(x+21, y, w-42, h);
  setc(0.10, 0.11, 0.13); recto(x+21, y, w-42, h);
  setc(0.82, 0.84, 0.90);
  sprintf(#tmp, "%d", val); ctext(x+21, y, w-42, h, #tmp);
  btn(x+w-20, y, 20, h, "+", 0) ? ( d = 1; );
  d;
);

function hslider(id x y w h val lo hi) local(nv) (
  (mouse_cap & 1) && hit(x, y, w, h) && drag_id == 0 ? ( drag_id = id; );
  setc(0.13, 0.14, 0.17); rectf(x, y, w, h);
  setc(0.22, 0.50, 0.90); rectf(x, y, w * (val - lo) / (hi - lo), h);
  setc(0.10, 0.11, 0.13); recto(x, y, w, h);
  nv = val;
  drag_id == id ? ( nv = floor(lo + (hi - lo) * max(0, min(1, (mouse_x - x) / w)) + 0.5); );
  setc(0.95, 0.96, 0.98);
  sprintf(#tmp, "%d", nv); ctext(x, y, w, h, #tmp);
  nv;
);

function fam_first(f) local(i) (
  i = 0;
  while (i < n_chords && CH_FAM[i] != f) ( i += 1; );
  i < n_chords ? i : 0;
);

function pc_name(s p) (
  ROOT_ACC[sel_root] < 0 ? idx_get(s, #pc_flat,  IDX_PCF, p % 12)
                         : idx_get(s, #pc_sharp, IDX_PCS, p % 12);
);

// "C E G B" for whatever chord is currently selected.
function tones_text(s inv) local(cnt i) (
  cnt = chord_tones(inv);
  strcpy(s, "");
  i = 0;
  while (i < cnt) (
    i ? strcat(s, " ");
    pc_name(#t9, TONES[i]);
    strcat(s, #t9);
    i += 1;
  );
  s;
);

// ---------------------------------------------------------------------------
// Shared parameter controls. Each one owns its own label, so a panel just says
// where to put it and the strip reads the same everywhere.
// ---------------------------------------------------------------------------

function ctl_rate(x y) local(r) (
  label(x, y, "RATE");
  r = btn_row(x, y+14, 52, 24, 4, #rate_names, IDX_RATE, n_rates, sel_rate);
  r >= 0 ? ( sel_rate = r; dirty = 1; );
  r = btn_row(x + 404, y+14, 62, 24, 4, #mod_names, IDX_MOD, n_mods, sel_mod);
  r >= 0 ? ( sel_mod = r; dirty = 1; );
);

function ctl_bars(x y) local(r) (
  label(x, y, "BARS");
  r = 0;
  btn(x,     y+14, 40, 24, "1", sel_bars == 1) ? ( r = 1; );
  btn(x+44,  y+14, 40, 24, "2", sel_bars == 2) ? ( r = 2; );
  btn(x+88,  y+14, 40, 24, "4", sel_bars == 4) ? ( r = 4; );
  btn(x+132, y+14, 40, 24, "8", sel_bars == 8) ? ( r = 8; );
  r ? ( sel_bars = r; dirty = 1; );
);

function ctl_octave(x y) local(d) (
  label(x, y, "OCTAVE");
  d = stepper(x, y+14, 84, 24, sel_oct);
  d ? ( sel_oct = max(-3, min(3, sel_oct + d)); dirty = 1; );
);

function ctl_octaves(x y) local(d) (
  label(x, y, "OCTAVES");
  d = stepper(x, y+14, 84, 24, sel_octaves);
  d ? ( sel_octaves = max(1, min(4, sel_octaves + d)); dirty = 1; );
);

function ctl_vel(x y) local(v) (
  label(x, y, "VELOCITY");
  v = hslider(11, x, y+14, 104, 24, sel_vel, 1, 127);
  v != sel_vel ? ( sel_vel = v; dirty = 1; );
);

function ctl_gate(x y) local(v) (
  label(x, y, "GATE %");
  v = hslider(12, x, y+14, 104, 24, sel_gate, 5, 100);
  v != sel_gate ? ( sel_gate = v; dirty = 1; );
);

// ---------------------------------------------------------------------------
// One panel per kind of block. Only ever one is on screen.
// ---------------------------------------------------------------------------

function panel_chord(x y) local(i r c cx cy) (
  label(x, y, "FAMILY");
  r = btn_row(x, y+14, 118, 24, 4, #fam_names, IDX_FAM, n_fams, sel_fam);
  r >= 0 ? ( sel_fam = r; sel_fam > 0 ? ( sel_chord = fam_first(sel_fam); ); dirty = 1; );

  label(x, y+44, "CHORD");
  sel_fam == 0 ? (
    r = btn_row(x, y+58, 104, 26, 4, #dia_names, IDX_DIA, n_dia, sel_dia);
    r >= 0 ? ( sel_dia = r; dirty = 1; );
    hit(x, y+58, 9*108, 26) ? strcpy(#hint, "Built from the scale itself, so it is always in key");
  ) : (
    c = 0; i = 0;
    while (i < n_chords) (
      CH_FAM[i] == sel_fam ? (
        cx = x + (c % 7) * 138;
        cy = y + 58 + floor(c / 7) * 30;
        idx_get(#tmp2, #chord_syms, IDX_CHS, i);
        btn(cx, cy, 134, 26, #tmp2, sel_chord == i) ? ( sel_chord = i; dirty = 1; );
        hit(cx, cy, 134, 26) ? idx_get(#hint, #chord_names, IDX_CHN, i);
        c += 1;
      );
      i += 1;
    );
  );

  label(x, y+122, "INVERSION");
  r = btn_row(x, y+136, 62, 24, 4, #inv_names, IDX_INV, n_invs, sel_inv);
  r >= 0 ? ( sel_inv = r; dirty = 1; );
  ctl_octave(x + 286, y+122);
  ctl_bars  (x + 390, y+122);
  ctl_vel   (x + 588, y+122);
  ctl_gate  (x + 712, y+122);
);

function panel_arp(x y) local(r i) (
  gfx_setfont(1); setc(0.72, 0.74, 0.80);
  chord_label(#t7); tones_text(#t8, sel_inv);
  sprintf(#tmp2, "Chord:  %s   (%s)   -  change it in the Chord tab", #t7, #t8);
  ltext(x, y+2, #tmp2);

  label(x, y+22, "DIRECTION");
  r = btn_row(x, y+36, 92, 24, 4, #pat_names, IDX_PAT, 7, sel_pat);
  r >= 0 ? ( sel_pat = r; dirty = 1; );

  label(x, y+66, "FIXED ORDER");
  r = -1; i = 7;
  while (i < n_pats) (
    idx_get(#tmp2, #pat_names, IDX_PAT, i);
    btn(x + (i-7)*96, y+80, 92, 24, #tmp2, sel_pat == i) ? ( r = i; );
    i += 1;
  );
  r >= 0 ? ( sel_pat = r; dirty = 1; );
  hit(x, y+80, 6*96, 24) ?
    strcpy(#hint, "The lowest three voices in that order; anything above them follows, then the cell climbs an octave");

  ctl_rate(x, y+110);

  ctl_octaves(x,       y+154);
  ctl_octave (x + 104, y+154);
  ctl_bars   (x + 208, y+154);
  ctl_vel    (x + 406, y+154);
  ctl_gate   (x + 530, y+154);
);

function panel_run(x y) local(r) (
  gfx_setfont(1); setc(0.72, 0.74, 0.80);
  idx_get(#t7, #root_names, IDX_ROOT, sel_root);
  idx_get(#t8, #scale_names, IDX_SCL, sel_scale);
  note_name(#t9, sel_degree);
  sprintf(#tmp2, "Runs the %s %s scale, starting on %s", #t7, #t8, #t9);
  ltext(x, y+2, #tmp2);

  label(x, y+30, "DIRECTION");
  r = btn_row(x, y+44, 92, 24, 4, #pat_names, IDX_PAT, 7, sel_rundir);
  r >= 0 ? ( sel_rundir = r; dirty = 1; );

  ctl_rate(x, y+80);

  ctl_octaves(x,       y+130);
  ctl_octave (x + 104, y+130);
  ctl_bars   (x + 208, y+130);
  ctl_vel    (x + 406, y+130);
  ctl_gate   (x + 530, y+130);
);

function panel_melody(x y) local(r) (
  gfx_setfont(1); setc(0.72, 0.74, 0.80);
  ltext(x, y+2, "The two smallest moves in a melody: a step to the next scale note, or a leap past it.");

  label(x, y+24, "INTERVAL");
  r = btn_row(x, y+38, 92, 24, 4, #mel_names, IDX_MEL, n_mels, sel_mel);
  r >= 0 ? ( sel_mel = r; dirty = 1; );
  hit(x, y+38, 7*96, 24) ? strcpy(#hint, "A 2nd is the step; everything wider is a leap");

  label(x + 700, y+24, "DIRECTION");
  btn(x + 700, y+38, 62, 24, "Up",   sel_meldir == 0) ? ( sel_meldir = 0; dirty = 1; );
  btn(x + 766, y+38, 62, 24, "Down", sel_meldir == 1) ? ( sel_meldir = 1; dirty = 1; );

  label(x, y+68, "SHAPE");
  r = btn_row(x, y+82, 92, 24, 4, #shape_names, IDX_SHP, n_shapes, sel_shape);
  r >= 0 ? ( sel_shape = r; dirty = 1; );
  hit(x, y+82, 3*96, 24) ?
    strcpy(#hint, "Single: the move. Return: there and back. Fill: every scale note in between");

  ctl_rate(x, y+112);

  ctl_octave(x,       y+156);
  ctl_vel   (x + 208, y+156);
  ctl_gate  (x + 332, y+156);
);

function panel_bass(x y) local(r d) (
  gfx_setfont(1); setc(0.72, 0.74, 0.80);
  chord_label(#t7); tones_text(#t8, 0);
  sprintf(#tmp2, "One note of the chord, on its own, low.   Chord:  %s   (%s)", #t7, #t8);
  ltext(x, y+2, #tmp2);

  label(x, y+30, "CHORD TONE");
  r = btn_row(x, y+44, 72, 24, 4, #btone_names, IDX_BTONE, n_btone, sel_btone);
  r >= 0 ? ( sel_btone = r; dirty = 1; );

  label(x + 320, y+30, "OCTAVES DOWN");
  d = stepper(x + 320, y+44, 84, 24, -sel_boct);
  d ? ( sel_boct = max(-3, min(0, sel_boct - d)); dirty = 1; );

  ctl_rate(x, y+80);

  ctl_bars(x,       y+130);
  ctl_vel (x + 208, y+130);
  ctl_gate(x + 332, y+130);
);

function panel_drums(x y) local(r) (
  gfx_setfont(1); setc(0.72, 0.74, 0.80);
  ltext(x, y+2, "One piece of the kit, one pattern, one bar. Stack them up by dropping in several.");

  label(x, y+30, "PIECE");
  r = btn_row(x, y+44, 104, 26, 4, #drp_names, IDX_DRP, n_drp, sel_drp);
  r >= 0 ? ( sel_drp = r; dirty = 1; );

  label(x, y+80, "PATTERN");
  r = btn_row(x, y+94, 104, 26, 4, #drs_names, IDX_DRS, n_drs, sel_drs);
  r >= 0 ? ( sel_drs = r; dirty = 1; );
  hit(x, y+94, 9*108, 26) ? strcpy(#hint, "Written on a 4/4 grid; hits past the end of a shorter bar are dropped");

  ctl_bars(x,       y+134);
  ctl_vel (x + 208, y+134);
);

// ---------------------------------------------------------------------------
// Preview. A plain piano roll of whatever the block currently is: the fastest
// way to tell a converging arpeggio from a diverging one without playing it.
// ---------------------------------------------------------------------------
function draw_preview(x y w h) local(i lo hi p st ln nx nw ny nh beats gx rowh) (
  setc(0.08, 0.09, 0.11); rectf(x, y, w, h);
  beats = max(total_beats, 0.0001);
  i = 0;
  while (i <= beats + 0.0001) (
    gx = x + w * (i / beats);
    (i - floor(i / bar_beats) * bar_beats) < 0.001 ? setc(0.25, 0.27, 0.32)
                                                   : setc(0.15, 0.16, 0.19);
    gfx_line(gx, y, gx, y + h);
    i += 1;
  );
  n_notes < 1 ? (
    gfx_setfont(1); setc(0.40, 0.42, 0.48); ctext(x, y, w, h, "nothing to play");
  ) : (
    lo = 200; hi = -1;
    i = 0;
    while (i < n_notes) ( p = NOTES[i*4+2]; p < lo ? ( lo = p; ); p > hi ? ( hi = p; ); i += 1; );
    // A single repeated note would otherwise fill the whole box, so always show
    // at least an octave of context.
    hi - lo < 11 ? ( lo = max(0, floor((lo + hi) / 2) - 6); hi = lo + 12; );
    rowh = h / (hi - lo + 1);
    nh = max(2, rowh - 1);
    i = 0;
    while (i < n_notes) (
      st = NOTES[i*4]; ln = NOTES[i*4+1]; p = NOTES[i*4+2];
      nx = x + w * (st / beats);
      nw = max(2, w * (ln / beats) - 1);
      ny = y + h - (p - lo + 1) * rowh;
      setc(0.34, 0.78, 0.55);
      gfx_a = 0.40 + 0.60 * (NOTES[i*4+3] / 127);
      rectf(nx, ny, nw, nh);
      i += 1;
    );
    gfx_a = 1;
  );
  play_on ? (
    setc(0.95, 0.80, 0.30);
    gx = x + w * min(1, (play_pos / (srate * 60 / max(cur_tempo, 1))) / beats);
    gfx_line(gx, y, gx, y + h);
  );
  setc(0.22, 0.24, 0.28); recto(x, y, w, h);
);

// ---------------------------------------------------------------------------
// The frame
// ---------------------------------------------------------------------------
mdown = mouse_cap & 1;
g_click = mdown && !last_mdown;
last_mdown = mdown;
!mdown ? ( drag_id = 0; );
strcpy(#hint, "");

gfx_setfont(1, "Arial", 14);
gfx_setfont(2, "Arial", 15, 'b');
gfx_setfont(3, "Arial", 11);
gfx_setfont(4, "Arial", 19, 'b');
gfx_setfont(1);

setc(0.105, 0.115, 0.135); rectf(0, 0, gfx_w, gfx_h);

!data_ok ? (
  gfx_setfont(2); setc(0.95, 0.5, 0.5);
  ctext(0, 0, gfx_w, gfx_h,
        "The chord tables and the chord names are different lengths - the plugin needs fixing.");
) : (

// @block owns the note buffer while it is being played out of, so leave the
// rebuild to it then; the preview is at most one frame behind either way.
dirty && !play_on ? ( regenerate(); );

// -- header ----------------------------------------------------------------
setc(0.145, 0.155, 0.185); rectf(0, 0, gfx_w, 32);
gfx_setfont(4); setc(0.93, 0.95, 0.99); ltext(14, 5, "STARTING BLOCKS");
gfx_setfont(3); setc(0.46, 0.48, 0.55); ltext(206, 12, "pick a key, pick a degree, drop in a block");
bridge_up ? setc(0.30, 0.80, 0.45) : setc(0.62, 0.30, 0.30);
gfx_circle(gfx_w - 196, 16, 5, 1, 1);
setc(0.66, 0.68, 0.75);
ltext(gfx_w - 182, 11, bridge_up ? "Bridge connected" : "Bridge not running");
gfx_setfont(1);

// -- key -------------------------------------------------------------------
label(14, 40, "KEY");
r = btn_row(14, 52, 51, 26, 3, #root_names, IDX_ROOT, n_roots, sel_root);
r >= 0 ? ( sel_root = r; dirty = 1; );

label(14, 84, "SCALE");
i = 0;
while (i < n_scales) (
  bx = 14 + (i % 8) * 122;
  by = 96 + floor(i / 8) * 26;
  idx_get(#tmp2, #scale_names, IDX_SCL, i);
  btn(bx, by, 118, 24, #tmp2, sel_scale == i) ? (
    sel_scale = i;
    sel_degree = min(sel_degree, SCL_N[sel_scale] - 1);
    dirty = 1;
  );
  i += 1;
);

// -- degree ----------------------------------------------------------------
label(14, 154, "SCALE DEGREE");
i = 0;
while (i < SCL_N[sel_scale]) (
  bx = 14 + i * 102;
  degree_numeral(#tmp2, i);
  btn(bx, 166, 96, 32, #tmp2, sel_degree == i) ? ( sel_degree = i; dirty = 1; );
  hit(bx, 166, 96, 32) ? degree_title(#hint, i);
  i += 1;
);
gfx_setfont(1); setc(0.86, 0.88, 0.93);
degree_title(#t7, sel_degree); note_name(#t8, sel_degree);
sprintf(#tmp2, "%s  %s", #t8, #t7);
ltext(14 + SCL_N[sel_scale] * 102 + 8, 176, #tmp2);

// -- which block -----------------------------------------------------------
label(14, 206, "BUILDING BLOCK");
r = btn_row(14, 218, 120, 30, 6, #cat_names, IDX_CAT, n_cats, sel_cat);
r >= 0 ? ( sel_cat = r; dirty = 1; );

// -- the panel for it ------------------------------------------------------
setc(0.135, 0.145, 0.17); rectf(6, 252, gfx_w - 12, 202);
setc(0.20, 0.22, 0.26);   recto(6, 252, gfx_w - 12, 202);
sel_cat == 0 ? panel_chord (20, 258) :
sel_cat == 1 ? panel_arp   (20, 258) :
sel_cat == 2 ? panel_run   (20, 258) :
sel_cat == 3 ? panel_melody(20, 258) :
sel_cat == 4 ? panel_bass  (20, 258) : panel_drums(20, 258);

// -- preview ---------------------------------------------------------------
label(14, 460, "BLOCK");
gfx_setfont(1); setc(0.88, 0.90, 0.95);
ltext(70, 458, #block_name);
gfx_setfont(3); setc(0.46, 0.48, 0.55);
sprintf(#tmp2, "%d notes  /  %.2f beats", n_notes, total_beats);
gfx_measurestr(#tmp2, tw, th);
ltext(gfx_w - 14 - tw, 460, #tmp2);
draw_preview(14, 474, gfx_w - 28, 76);

// -- hint ------------------------------------------------------------------
gfx_setfont(3); setc(0.52, 0.54, 0.62);
ltext(14, 556, #hint);

// -- what to do with it ----------------------------------------------------
gfx_setfont(1);
btn(14, 572, 110, 32, play_on ? "Stop" : "Audition", play_on) ? (
  play_on = !play_on;
  play_pos = 0;
  play_on ? 0 : ( req_alloff = 1; );
);
btn(130, 572, 70, 32, "Loop", loop_on) ? ( loop_on = !loop_on; );

btn(220, 572, 160, 32, "Insert at cursor", 0) ? ( req_cmd = 1; last_status = -1; );
btn(388, 572, 160, 32, "Export .mid", 0)      ? ( req_cmd = 2; last_status = -1; );
hit(220, 572, 160, 32) ? strcpy(#hint, "Places the block on the selected track at the edit cursor");
hit(388, 572, 160, 32) ? strcpy(#hint, "Writes a .mid into the drag bin folder, ready to drag in from the Media Explorer");

gfx_setfont(1); setc(0.62, 0.65, 0.72);
!bridge_up ? (
  setc(0.85, 0.62, 0.35);
  ltext(564, 580, "Insert and Export need Starting Blocks Bridge.lua running");
) : (
  last_status == 0 ? ltext(564, 580, "Inserted at the edit cursor") :
  last_status == 1 ? ltext(564, 580, "Written to the drag bin") :
  last_status == 2 ? ( setc(0.90, 0.60, 0.40); ltext(564, 580, "No track selected"); ) :
  last_status == 3 ? ( setc(0.90, 0.60, 0.40); ltext(564, 580, "Could not write the file"); ) : 0;
);

);   // data_ok
